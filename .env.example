# Used by docker-compose.yml for variable interpolation (separate from
# api/.env.example, which is for running the api directly without Docker).
# Copy to .env at the repo root, then `docker compose up --build`.

POSTGRES_DB=library_docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# AI Query Agent (Anthropic). Optional — /ai routes return 503 without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
